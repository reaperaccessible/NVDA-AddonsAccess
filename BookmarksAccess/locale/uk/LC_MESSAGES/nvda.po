msgstr "Нових адрес: {count}, з {browsers}."

msgid "The update is installed. NVDA must restart to finish. Restart now?"
msgstr "Оновлення встановлено. Щоб завершити, потрібно перезапустити NVDA. Перезапустити зараз?"

msgid "Downloading the update..."
msgstr "Завантаження оновлення..."

msgid "Checking for updates..."
msgstr "Перевірка оновлень..."

msgid "{name} update"
msgstr "Оновлення {name}"

msgid "{name} {new} is available. You have version {current}. Do you want to install it now?"
msgstr "Доступна версія {new} додатка {name}. У вас версія {current}. Бажаєте встановити її зараз?"

msgid "The update is already installed. Restart NVDA to finish."
msgstr "Оновлення вже встановлено. Перезапустіть NVDA, щоб завершити."

msgid "The update could not be downloaded."
msgstr "Не вдалося завантажити оновлення."

msgid "Downloading the update: {percent}%"
msgstr "Завантаження оновлення: {percent}%"

msgid "The update could not be installed."
msgstr "Не вдалося встановити оновлення."

msgid "Could not check for updates. Check your Internet connection."
msgstr "Не вдалося перевірити оновлення. Перевірте з'єднання з Інтернетом."

msgid "{name} is up to date (version {version})."
msgstr "{name} має найновішу версію ({version})."
