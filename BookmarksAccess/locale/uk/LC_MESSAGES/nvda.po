msgid "&Advanced options..."
msgstr "&Додаткові параметри..."

msgid "Address copied. Already in your bookmarks."
msgstr "Адресу скопійовано. Вона вже є у ваших закладках."

msgid "Already in your bookmarks."
msgstr "Вже є у ваших закладках."

msgid "{name} (empty)"
msgstr "{name} (порожньо)"

msgid "{count} items cut"
msgstr "Вирізано елементів: {count}"

msgid "Delete {name}?"
msgstr "Видалити {name}?"

msgid "Delete the folder {name} and the {count} addresses inside it?"
msgstr "Видалити папку {name} і всі адреси в ній ({count})?"

msgid "Delete the folder {name}?"
