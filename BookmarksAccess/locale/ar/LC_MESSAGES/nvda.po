msgstr "أول القائمة"

msgid "Deleted"
msgstr "تم الحذف"

msgid "Importing..."
msgstr "جارٍ الاستيراد..."

msgid "The list could not be saved."
msgstr "تعذّر حفظ القائمة."

msgid "First, {name}"
msgstr "الأول، {name}"

msgid "Last, {name}"
msgstr "الأخير، {name}"

msgid "Add"
msgstr "إضافة"

msgid "Type the address first."
msgstr "اكتب العنوان أولًا."

msgid "Keys of BookmarksAccess"
msgstr "مفاتيح BookmarksAccess"

msgid "&Close"
msgstr "إ&غلاق"

msgid "&Open"
msgstr "&فتح"

msgid "&Add an address..."
msgstr "إ&ضافة عنوان..."

msgid "&Import from the browsers"
msgstr "&استيراد من المتصفحات"

msgid "This is a folder, not an address."
msgstr "هذا مجلد، وليس عنوانًا."

msgid "{count} items moved to {folder}"
msgstr "تم نقل {count} عناصر إلى {folder}"

msgid "Nothing to paste. Cut with Control+X first."
msgstr "لا شيء للصق. قص أولًا باستخدام Control+X."

msgid "Nothing moved: the items are already there."
msgstr "لم يُنقل شيء: العناصر موجودة هناك بالفعل."

msgid "Address copied"
msgstr "تم نسخ العنوان"

msgid "No bookmarks found in Chrome, Edge, Brave or Firefox."
msgstr "لم يتم العثور على أي مفضلات في Chrome أو Edge أو Brave أو Firefox."

msgid "No new address."
msgstr "لا يوجد عنوان جديد."

msgid "Advanced options of BookmarksAccess"
msgstr "الخيارات المتقدمة لـ BookmarksAccess"

msgid "Not in a web browser."
msgstr "لست في متصفح ويب."

msgid "No web page found. Move to the page first."
msgstr "لم يتم العثور على صفحة ويب. انتقل إلى الصفحة أولًا."

msgid "New fol&der..."
msgstr "مجلد &جديد..."

msgid "&Keys of the window:"
msgstr "&مفاتيح النافذة:"

msgid "NVDA+Control+Shift+U"
msgstr "NVDA+Control+Shift+U"

msgid "The Applications key shows the commands; Control+Shift+H, the list of keys."
msgstr "مفتاح التطبيقات يعرض الأوامر؛ وControl+Shift+H يعرض قائمة المفاتيح."

msgid "&Sort by:"
msgstr "&ترتيب حسب:"

msgid "&Bookmarks:"
msgstr "المفض&لات:"

msgid "{name}, selected"
msgstr "{name}، محدد"

msgid "This address could not be opened."
msgstr "تعذّر فتح هذا العنوان."

msgid "Moved to {folder}"
msgstr "تم النقل إلى {folder}"

msgid "Move {name}"
msgstr "نقل {name}"

msgid "Move {count} items"
msgstr "نقل {count} عناصر"

msgid "Delete the {count} selected items, and everything inside the folders?"
msgstr "حذف العناصر المحددة ({count}) وكل ما في المجلدات؟"

msgid "&Copy the address to the clipboard when adding the current page"
msgstr "&نسخ العنوان إلى الحافظة عند إضافة الصفحة الحالية"

msgid "Check for &updates automatically when NVDA starts"
msgstr "البحث عن ال&تحديثات تلقائيًا عند بدء تشغيل NVDA"

msgid "Check for updates &now"
msgstr "البحث عن التحديثات ا&لآن"

msgid "&Advanced options..."
msgstr "خيارات &متقدمة..."

msgid "Address copied. Already in your bookmarks."
msgstr "تم نسخ العنوان. وهو موجود بالفعل في مفضلاتك."

msgid "Already in your bookmarks."
msgstr "موجود بالفعل في مفضلاتك."

msgid "{name} (empty)"
msgstr "{name} (فارغ)"

msgid "{count} items cut"
msgstr "تم قص {count} عناصر"

msgid "Delete {name}?"
msgstr "هل تريد حذف {name}؟"

msgid "Delete the folder {name} and the {count} addresses inside it?"
msgstr "هل تريد حذف المجلد {name} والعناوين التي بداخله وعددها {count}؟"

msgid "Delete the folder {name}?"
msgstr "هل تريد حذف المجلد {name}؟"

msgid "1 new address, from {browsers}."
msgstr "عنوان جديد واحد، من {browsers}."

msgid "{count} new addresses, from {browsers}."
msgstr "عدد العناوين الجديدة: {count}، من {browsers}."

msgid "The update is installed. NVDA must restart to finish. Restart now?"
msgstr "تم تثبيت التحديث. يجب إعادة تشغيل NVDA للإنهاء. هل تريد إعادة التشغيل الآن؟"

msgid "Downloading the update..."
msgstr "جارٍ تنزيل التحديث..."

msgid "Checking for updates..."
msgstr "جار التحقق من التحديثات..."

msgid "{name} update"
msgstr "تحديث {name}"

msgid "{name} {new} is available. You have version {current}. Do you want to install it now?"
msgstr "{name} {new} متوفر. لديك الإصدار {current}. هل تريد تثبيته الآن؟"

msgid "The update is already installed. Restart NVDA to finish."
msgstr "التحديث مثبت بالفعل. أعد تشغيل NVDA للإنهاء."

msgid "The update could not be downloaded."
msgstr "تعذر تنزيل التحديث."

msgid "Downloading the update: {percent}%"
msgstr "جارٍ تنزيل التحديث: {percent}%"

msgid "The update could not be installed."
msgstr "تعذر تثبيت التحديث."

msgid "Could not check for updates. Check your Internet connection."
msgstr "تعذر التحقق من التحديثات. تحقق من اتصالك بالإنترنت."

msgid "{name} is up to date (version {version})."
msgstr "{name} محدّث (الإصدار {version})."
