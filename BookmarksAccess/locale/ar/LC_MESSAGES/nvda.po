msgid "Adds the current web page to BookmarksAccess, and copies its address"
msgstr "يضيف صفحة الويب الحالية إلى BookmarksAccess، وينسخ عنوانها"

msgid "Opens BookmarksAccess, your list of bookmarks"
msgstr "يفتح BookmarksAccess، قائمة مفضلاتك"

msgid "My order"
msgstr "ترتيبي"

msgid "Name, from A to Z"
msgstr "الاسم، من أ إلى ي"

msgid "Name, from Z to A"
msgstr "الاسم، من ي إلى أ"

msgid "Date added, newest first"
msgstr "تاريخ الإضافة، الأحدث أولًا"

msgid "Date added, oldest first"
msgstr "تاريخ الإضافة، الأقدم أولًا"

msgid "Most opened first"
msgstr "الأكثر فتحًا أولًا"

msgid "Bookmarks bar"
msgstr "شريط المفضلات"

msgid "Bookmarks menu"
msgstr "قائمة الإشارات المرجعية"

msgid "Other bookmarks"
msgstr "مفضلات أخرى"

msgid "Mobile bookmarks"
msgstr "مفضلات الجوال"

msgid "Your list is empty. Import the bookmarks of your web browsers now?"
msgstr "قائمتك فارغة. هل تريد استيراد مفضلات متصفحات الويب لديك الآن؟"

