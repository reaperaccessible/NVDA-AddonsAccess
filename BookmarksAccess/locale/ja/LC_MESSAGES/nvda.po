msgstr "すでにブックマークにあります。"

msgid "{name} (empty)"
msgstr "{name}(空)"

msgid "{count} items cut"
msgstr "{count} 個の項目を切り取りました"

msgid "Delete {name}?"
msgstr "{name} を削除しますか?"

msgid "Delete the folder {name} and the {count} addresses inside it?"
