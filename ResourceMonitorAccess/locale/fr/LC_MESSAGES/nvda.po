msgstr "Téléchargement : {received} par seconde, envoi : {sent} par seconde."

msgid "No battery."
msgstr "Aucune batterie."

msgid "Battery at {level}%, plugged in."
msgstr "Batterie à {level} %, branchée."

msgid "Battery at {level}%, {duration} left."
msgstr "Batterie à {level} %, il reste {duration}."

msgid "Battery at {level}%, not plugged in."
msgstr "Batterie à {level} %, non branchée."

msgid "Announces the applications using the most processor and memory. Pressed twice, copies it."
msgstr "Annonce les applications qui utilisent le plus de processeur et de mémoire. Appuyé deux fois, les copie."

msgid "Announces how the computer is connected, whether the Internet is reachable, and the current speed. Pressed twice, copies it."
msgstr "Annonce comment l'ordinateur est connecté, si Internet est accessible, et la vitesse du moment. Appuyé deux fois, le copie."

msgid "Announces the battery level of a laptop. Pressed twice, copies it."
msgstr "Annonce le niveau de la batterie d'un portable. Appuyé deux fois, le copie."

msgid "Internet speed test"
msgstr "Test de vitesse Internet"

msgid "Please wait."
msgstr "Veuillez patienter."

msgid "A speed test is already running."
msgstr "Un test de vitesse est déjà en cours."

msgid "Starting the Internet speed test. Please wait, it can take up to 15 seconds. Avoid using the Internet meanwhile: it would lower the result, which will be announced by itself."
msgstr "Démarrage du test de vitesse Internet. Veuillez patienter, cela peut prendre jusqu'à 15 secondes. Évitez d'utiliser Internet pendant ce temps : le résultat serait faussé. Il sera annoncé de lui-même."

msgid "Tests the speed of the Internet connection, in 15 seconds at most."
msgstr "Teste la vitesse de la connexion Internet, en 15 secondes au plus."

msgid "{value} megabits per second"
msgstr "{value} mégabits par seconde"

msgid "The speed test could not be done: the Internet is not reachable."
msgstr "Le test de vitesse n'a pas pu se faire : Internet est inaccessible."

msgid "Download: {down}. Upload: {up}. Response time: {latency} milliseconds."
msgstr "Téléchargement : {down}. Envoi : {up}. Temps de réponse : {latency} millisecondes."

msgid "The speed test could not be done. Try again later."
msgstr "Le test de vitesse n'a pas pu se faire. Réessayez plus tard."

msgid "Download: {down}. Upload: could not be measured. Response time: {latency} milliseconds."
msgstr "Téléchargement : {down}. Envoi : impossible à mesurer. Temps de réponse : {latency} millisecondes."

msgid "The speed test service limits tests that are too frequent. Try again in {duration}."
msgstr "Le service de test de vitesse limite les tests trop fréquents. Réessayez dans {duration}."

msgid "The speed test service limits tests that are too frequent. Try again later."
msgstr "Le service de test de vitesse limite les tests trop fréquents. Réessayez plus tard."

msgid "The update is installed. NVDA must restart to finish. Restart now?"
msgstr "La mise à jour est installée. NVDA doit redémarrer pour terminer. Redémarrer maintenant ?"

msgid "Downloading the update..."
msgstr "Téléchargement de la mise à jour..."

msgid "Checking for updates..."
msgstr "Recherche de mises à jour..."

msgid "{name} update"
msgstr "Mise à jour de {name}"

msgid "{name} {new} is available. You have version {current}. Do you want to install it now?"
msgstr "{name} {new} est disponible. Vous avez la version {current}. Voulez-vous l'installer maintenant ?"

msgid "The update is already installed. Restart NVDA to finish."
msgstr "La mise à jour est déjà installée. Redémarrez NVDA pour terminer."

msgid "The update could not be downloaded."
msgstr "La mise à jour n'a pas pu être téléchargée."

msgid "Downloading the update: {percent}%"
msgstr "Téléchargement de la mise à jour : {percent} %"

msgid "The update could not be installed."
msgstr "La mise à jour n'a pas pu être installée."

msgid "Could not check for updates. Check your Internet connection."
msgstr "Impossible de vérifier les mises à jour. Vérifiez votre connexion Internet."

msgid "{name} is up to date (version {version})."
msgstr "{name} est à jour (version {version})."
